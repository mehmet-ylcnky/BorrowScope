{
  "name": "borrowscope",
  "displayName": "BorrowScope",
  "description": "Real-time ownership visualization for Rust",
  "version": "0.1.0",
  "publisher": "borrowscope",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mehmet-ylcnky/BorrowScope"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Visualization"],
  "activationEvents": ["onLanguage:rust"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "borrowscope.showGraph", "title": "BorrowScope: Show Ownership Graph" },
      { "command": "borrowscope.inspectVariable", "title": "BorrowScope: Inspect Variable" },
      { "command": "borrowscope.toggleDecorations", "title": "BorrowScope: Toggle Decorations" },
      { "command": "borrowscope.restartServer", "title": "BorrowScope: Restart Server" },
      { "command": "borrowscope.toggleRuntime", "title": "BorrowScope: Toggle Runtime Overlay" },
      { "command": "borrowscope.runtime.enable", "title": "BorrowScope: Enable Runtime Overlay" },
      { "command": "borrowscope.runtime.disable", "title": "BorrowScope: Disable Runtime Overlay" },
      { "command": "borrowscope.runtime.toggleTimings", "title": "BorrowScope: Toggle Timing Annotations" },
      { "command": "borrowscope.runtime.toggleDropOrder", "title": "BorrowScope: Toggle Drop Order" },
      { "command": "borrowscope.runtime.toggleRefCounts", "title": "BorrowScope: Toggle Ref Count Display" },
      { "command": "borrowscope.runtime.toggleDivergences", "title": "BorrowScope: Toggle Divergence Highlights" },
      { "command": "borrowscope.runtime.setSource", "title": "BorrowScope: Set Runtime Event Source" },
      { "command": "borrowscope.nextConflict", "title": "BorrowScope: Next Borrow Conflict" },
      { "command": "borrowscope.prevConflict", "title": "BorrowScope: Previous Borrow Conflict" },
      { "command": "borrowscope.focusGraph", "title": "BorrowScope: Focus Graph Panel" },
      { "command": "borrowscope.toggleBorrowScopes", "title": "BorrowScope: Toggle Borrow Scope Highlighting" },
      { "command": "borrowscope.toggleGutterIcons", "title": "BorrowScope: Toggle Gutter Icons" },
      { "command": "borrowscope.toggleLifelines", "title": "BorrowScope: Toggle Lifeline Decorations" },
      { "command": "borrowscope.toggleCodeLens", "title": "BorrowScope: Toggle CodeLens" },
      { "command": "borrowscope.showTimeline", "title": "BorrowScope: Show Timeline View" },
      { "command": "borrowscope.showScopes", "title": "BorrowScope: Show Scope Nesting View" },
      { "command": "borrowscope.showRefCount", "title": "BorrowScope: Show Reference Count Chart" },
      { "command": "borrowscope.showMoves", "title": "BorrowScope: Show Move Chains" },
      { "command": "borrowscope.showServerOutput", "title": "BorrowScope: Show Server Output" },
      { "command": "borrowscope.exportDot", "title": "BorrowScope: Export Graph as DOT" },
      { "command": "borrowscope.exportSvg", "title": "BorrowScope: Export Graph as SVG" }
    ],
    "keybindings": [
      { "command": "borrowscope.showGraph", "key": "ctrl+shift+o", "when": "editorLangId == rust" },
      { "command": "borrowscope.inspectVariable", "key": "ctrl+shift+i", "when": "editorLangId == rust" },
      { "command": "borrowscope.toggleDecorations", "key": "ctrl+shift+d", "when": "editorLangId == rust" },
      { "command": "borrowscope.nextConflict", "key": "alt+shift+n", "when": "editorLangId == rust" },
      { "command": "borrowscope.prevConflict", "key": "alt+shift+p", "when": "editorLangId == rust" },
      { "command": "borrowscope.focusGraph", "key": "ctrl+shift+g", "when": "editorLangId == rust" }
    ],
    "colors": [
      { "id": "borrowscope.sharedBorrowBackground", "description": "Background for shared borrow scope regions", "defaults": { "dark": "#3498db15", "light": "#3498db10", "highContrast": "#3498db30" } },
      { "id": "borrowscope.sharedBorrowBorder", "description": "Border for shared borrow scope", "defaults": { "dark": "#3498db60", "light": "#3498db40", "highContrast": "#3498dbff" } },
      { "id": "borrowscope.mutBorrowBackground", "description": "Background for mutable borrow scope regions", "defaults": { "dark": "#e74c3c15", "light": "#e74c3c10", "highContrast": "#e74c3c30" } },
      { "id": "borrowscope.mutBorrowBorder", "description": "Border for mutable borrow scope", "defaults": { "dark": "#e74c3c60", "light": "#e74c3c40", "highContrast": "#e74c3cff" } },
      { "id": "borrowscope.moveHighlight", "description": "Highlight for move operations", "defaults": { "dark": "#e67e2220", "light": "#e67e2215", "highContrast": "#e67e2240" } },
      { "id": "borrowscope.rcArcHighlight", "description": "Highlight for Rc/Arc operations", "defaults": { "dark": "#9b59b620", "light": "#9b59b615", "highContrast": "#9b59b640" } },
      { "id": "borrowscope.conflictBackground", "description": "Background for borrow conflict regions", "defaults": { "dark": "#e74c3c20", "light": "#e74c3c15", "highContrast": "#e74c3c50" } },
      { "id": "borrowscope.dropIndicator", "description": "Color for drop/end-of-life indicators", "defaults": { "dark": "#95a5a680", "light": "#95a5a660", "highContrast": "#95a5a6ff" } },
      { "id": "borrowscope.runtimeTiming", "description": "Color for runtime timing annotations", "defaults": { "dark": "#2ecc7199", "light": "#27ae6099", "highContrast": "#2ecc71ff" } },
      { "id": "borrowscope.divergenceHighlight", "description": "Background for static/runtime divergences", "defaults": { "dark": "#e74c3c10", "light": "#e74c3c08", "highContrast": "#e74c3c30" } }
    ],
    "configuration": {
      "title": "BorrowScope",
      "properties": {
        "borrowscope.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the borrowscope-lsp binary. If empty, searches PATH."
        },
        "borrowscope.decorations.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline ownership decorations."
        },
        "borrowscope.highlights.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show borrow scope background highlights."
        },
        "borrowscope.decorations.borrowScopes": {
          "type": "boolean",
          "default": true,
          "description": "Highlight borrow scope regions."
        },
        "borrowscope.graph.layout": {
          "type": "string",
          "enum": ["force", "hierarchical", "radial"],
          "default": "hierarchical",
          "description": "Graph layout algorithm."
        },
        "borrowscope.crossFunction.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show cross-function borrow tracking."
        },
        "borrowscope.crossFunction.maxDepth": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum call chain depth to trace."
        },
        "borrowscope.crossFunction.showInline": {
          "type": "boolean",
          "default": true,
          "description": "Show inline annotations on cross-function call lines."
        },
        "borrowscope.memoryLayout.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show memory layout CodeLens and panel tab."
        },
        "borrowscope.memoryLayout.showAlignment": {
          "type": "boolean",
          "default": true,
          "description": "Show alignment info in memory layout."
        },
        "borrowscope.memoryLayout.animationSpeed": {
          "type": "number",
          "default": 600,
          "minimum": 100,
          "maximum": 2000,
          "description": "Animation speed in ms per line step."
        },
        "borrowscope.runtime.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable runtime data overlay (requires borrowscope-runtime instrumentation)."
        },
        "borrowscope.runtime.source": {
          "type": "string",
          "enum": ["file", "websocket"],
          "default": "file",
          "description": "How to receive runtime events."
        },
        "borrowscope.runtime.filePath": {
          "type": "string",
          "default": ".borrowscope/events.json",
          "description": "Path to runtime events file (relative to workspace)."
        },
        "borrowscope.runtime.websocketPort": {
          "type": "number",
          "default": 9876,
          "description": "WebSocket port for live runtime events."
        },
        "borrowscope.runtime.showTimings": {
          "type": "boolean",
          "default": true,
          "description": "Show variable lifetime durations inline."
        },
        "borrowscope.runtime.showDropOrder": {
          "type": "boolean",
          "default": false,
          "description": "Show drop order numbers."
        },
        "borrowscope.runtime.showRefCounts": {
          "type": "boolean",
          "default": true,
          "description": "Show Rc/Arc reference count changes."
        },
        "borrowscope.runtime.highlightDivergences": {
          "type": "boolean",
          "default": true,
          "description": "Highlight where static and runtime analysis disagree."
        },
        "borrowscope.server.extraArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional arguments passed to the server binary."
        },
        "borrowscope.analysis.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "maximum": 2000,
          "description": "Milliseconds to wait after last keystroke before re-analyzing."
        },
        "borrowscope.decorations.gutterIcons": {
          "type": "boolean",
          "default": true,
          "description": "Show borrow/move/drop icons in the gutter."
        },
        "borrowscope.decorations.inlayHints": {
          "type": "boolean",
          "default": true,
          "description": "Show ownership category hints inline (e.g., [Rc], [&mut])."
        },
        "borrowscope.decorations.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show ownership statistics above functions."
        },
        "borrowscope.decorations.lifelines": {
          "type": "boolean",
          "default": true,
          "description": "Show lifeline flow decorations (├─, │, ╰─)."
        },
        "borrowscope.graph.showTypes": {
          "type": "boolean",
          "default": true,
          "description": "Show type names on graph nodes."
        },
        "borrowscope.graph.animateUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Animate graph transitions on updates."
        },
        "borrowscope.colors.sharedBorrow": {
          "type": "string",
          "default": "#3498db",
          "description": "Color for shared borrow (&T) elements."
        },
        "borrowscope.colors.mutableBorrow": {
          "type": "string",
          "default": "#e74c3c",
          "description": "Color for mutable borrow (&mut T) elements."
        },
        "borrowscope.colors.move": {
          "type": "string",
          "default": "#e67e22",
          "description": "Color for move/ownership transfer elements."
        },
        "borrowscope.colors.rcArc": {
          "type": "string",
          "default": "#9b59b6",
          "description": "Color for Rc/Arc shared ownership elements."
        },
        "borrowscope.colors.owned": {
          "type": "string",
          "default": "#2ecc71",
          "description": "Color for owned variable elements."
        },
        "borrowscope.colors.drop": {
          "type": "string",
          "default": "#95a5a6",
          "description": "Color for drop/end-of-life elements."
        },
        "borrowscope.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show borrow conflict diagnostics in Problems panel."
        },
        "borrowscope.diagnostics.severity": {
          "type": "string",
          "enum": ["information", "hint", "warning"],
          "default": "information",
          "description": "Severity level for BorrowScope diagnostics."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha --require ./test-setup.js 'out/test/suite/**/*.test.js' --ignore 'out/test/suite/integration.test.js'",
    "test:integration": "node out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "mocha": "^10.2.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
